# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---- PyInstaller / build output ----
build/
_b2/
_b3/
_b4/
*.spec

# ---- local debug & capture artifacts ----
_sh/
_g*.txt
_st*.txt
_exe_*.txt
_*.png
_*.ps1
_*.py
_*.txt
_*.log

# ---- runtime reports (generated by the cleaner itself) ----
cleanup_report_*.log
cleanup_report_*.html
autorun_report_*.log
autorun_report_*.html
selftest_report_*.html
_layout*.txt

# ---- shipped binary ----
# dist/ holds the build output; the ready-to-use exe is distributed through
# the project website, so the folder itself is not versioned.
dist/*
!dist/CleanCDrive.exe
!dist/cleanup_config.ini
